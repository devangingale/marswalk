# Copy to app/.env.local for local development, or set the same names as GitHub repository
# variables/secrets for the production build (.github/workflows/deploy-pages.yml).
# Every VITE_ value is compiled into the public JavaScript bundle: none of them is secret.

# Cesium ion access token. Streams the Cesium Mars 3D Tiles (ion asset 3644333) used for the
# globe, the 3D terrain, and eye-level orbital recon at known sites. Without it the app runs
# offline: imagery on the smooth Mars ellipsoid, no relief. In the Cesium ion dashboard,
# restrict the token to the production domain (Allowed URLs) and to asset 3644333.
VITE_CESIUM_ION_TOKEN=

# Public URL of the production Cloudflare R2 bucket, no trailing slash
# (https://pub-<hash>.r2.dev or a custom domain). Production loads panoramas.json, panos/,
# passes/ and the site bundles from here. Leave empty in development, where the Vite dev
# server serves app/public/panoramas.json and /local-bundles.
VITE_R2_BASE_URL=

# Optional overrides.
# VITE_TILES_BASE=        site bundles (defaults to VITE_R2_BASE_URL in production)
# VITE_GLOBE_BASE=        whole-planet layer set (defaults to /sample/globe)
# VITE_PANORAMAS_URL=     panoramas.json location in any environment
