{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/r2/:path*", "destination": "https://pub-86c84e26d2634d8da51ff61ec5435551.r2.dev/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/r2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/r2/(.*)\\.(png|jpg|webp|glb|bin|pmtiles)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/r2/(.*)\\.(json|geojson)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
